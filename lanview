def get_kscreen_positions():
    """Liest die exakten Monitor-Positionen (x, y, width, height) unter Wayland (KDE kscreen-doctor, wlroots wlr-randr, Hyprland)."""
    pos_map = {}
    try:
        for uid_dir in os.listdir("/run/user"):
            if not uid_dir.isdigit():
                continue
            rdir = f"/run/user/{uid_dir}"
            uid_int = int(uid_dir)
            wayland_sock = None
            for entry in sorted(os.listdir(rdir)):
                if re.match(r"^wayland-\d+$", entry):
                    wayland_sock = entry
                    break
            if not wayland_sock:
                continue
            base_env = ["sudo", "-u", f"#{uid_int}", "env", f"XDG_RUNTIME_DIR={rdir}", f"WAYLAND_DISPLAY={wayland_sock}"]
            # 1. KDE Plasma Wayland (kscreen-doctor -j)
            res = subprocess.run(base_env + ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=3)
            if res.returncode == 0 and res.stdout.strip():
                data = json.loads(res.stdout)
                for o in data.get("outputs", []):
                    if o.get("connected") and o.get("enabled"):
                        name = o.get("name", "")
                        pos = o.get("pos", {})
                        size = o.get("size", {})
                        scale = float(o.get("scale", 1.0) or 1.0)
                        pos_map[name] = {
                            "x": int(pos.get("x", 0)),
                            "y": int(pos.get("y", 0)),
                            "width": int(round(size.get("width", 1920) / scale)),
                            "height": int(round(size.get("height", 1080) / scale)),
                            "phys_width": int(size.get("width", 1920)),
                            "phys_height": int(size.get("height", 1080)),
                            "priority": int(o.get("priority", 99))
                        }
                if pos_map:
                    return pos_map
            # 2. Sway / wlroots Wayland (wlr-randr --json)
            res = subprocess.run(base_env + ["wlr-randr", "--json"], capture_output=True, text=True, timeout=3)
            if res.returncode == 0 and res.stdout.strip():
                data = json.loads(res.stdout)
                for o in data:
                    if o.get("enabled"):
                        name = o.get("name", "")
                        pos = o.get("position", {})
                        scale = float(o.get("scale", 1.0) or 1.0)
                        w, h = 1920, 1080
                        for m in o.get("modes", []):
                            if m.get("current"):
                                w = int(m.get("width", 1920))
                                h = int(m.get("height", 1080))
                                break
                        pos_map[name] = {
                            "x": int(pos.get("x", 0)),
                            "y": int(pos.get("y", 0)),
                            "width": int(round(w / scale)),
                            "height": int(round(h / scale)),
                            "phys_width": w,
                            "phys_height": h,
                            "priority": 1
                        }
                if pos_map:
                    return pos_map
    except Exception:
        pass
    return pos_map

libdrm = ctypes.CDLL("libdrm.so.2")
libdrm.drmModeGetResources.restype = ctypes.POINTER(drmModeRes)
