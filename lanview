            if need_restart and cur_fb != 0:
                cur_mon["crtc_id"] = cur_crtc
                cur_mon["width"] = matched["width"]
                cur_mon["height"] = matched["height"]
                self.last_capture_ts = time.time()
                self.start_stream(mon_index=cur_mon["index"], force_restart=True)


