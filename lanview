def send_packet(magic: bytes, payload: bytes):
    header = magic + struct.pack(">I", len(payload))
    with out_lock:
        stdout_bin.write(header + payload)
        stdout_bin.flush()

def send_json(obj: dict):
    raw = json.dumps(obj, ensure_ascii=False).encode("utf-8")
    send_packet(b"LVJS", raw)

def send_frame(mon_index: int, jpeg_bytes: bytes):
    # 1 Byte Monitor-Index vor den JPEG-Daten, damit der Client beim Umschalten alte Frames sofort erkennt
    payload = struct.pack("B", int(mon_index) & 0xFF) + jpeg_bytes
    send_packet(b"LVFR", payload)

