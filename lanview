try:
    libdrm.drmModeGetFB2.restype = ctypes.POINTER(drmModeFB2)
    libdrm.drmModeFreeFB2.argtypes = [ctypes.POINTER(drmModeFB2)]
    HAS_FB2 = True
except Exception:
    HAS_FB2 = False

def query_drm_state(card_filter=None):
    """Liest den aktuellen DRM-Zustand (Connectors -> CRTCs -> FB-IDs) schnell aus."""
    cards = [card_filter] if card_filter else sorted([
        f"/dev/dri/{d}" for d in os.listdir("/dev/dri")
        if re.match(r"^card\d+$", d)
    ])
    for card_path in cards:
        try:
            fd = os.open(card_path, os.O_RDWR)
        except Exception:
            continue
        try:
            res_ptr = libdrm.drmModeGetResources(fd)
            if not res_ptr:
                os.close(fd)
                continue
            res = res_ptr.contents
            card_mons = []
            for i in range(res.count_connectors):
                conn_id = res.connectors[i]
                conn_ptr = libdrm.drmModeGetConnectorCurrent(fd, conn_id)
                if not conn_ptr:
                    continue
                conn = conn_ptr.contents
                cname = f"{CONN_TYPES.get(conn.connector_type, str(conn.connector_type))}-{conn.connector_type_id}"
                if conn.connection == 1 and conn.encoder_id:
                    enc_ptr = libdrm.drmModeGetEncoder(fd, conn.encoder_id)
                    if not enc_ptr or not enc_ptr.contents.crtc_id:
                        continue
                    crtc_id = enc_ptr.contents.crtc_id
                    crtc_ptr = libdrm.drmModeGetCrtc(fd, crtc_id)
                    if not crtc_ptr:
                        continue
                    crtc = crtc_ptr.contents
                    w = int(crtc.width) if crtc.width > 0 else 1920
                    h = int(crtc.height) if crtc.height > 0 else 1080
                    needs_gbm = False
                    if HAS_FB2 and crtc.buffer_id:
                        try:
                            fb2_ptr = libdrm.drmModeGetFB2(fd, crtc.buffer_id)
                            if fb2_ptr:
                                fb2 = fb2_ptr.contents
                                # Multi-Plane CCS-Kompression (z. B. Intel Gen12+ Iris Xe auf ws5)
                                # oder 10-Bit-Farbtiefe (AB30/XB30/AR30/XR30) -> GBM Multi-Plane Decompressor nutzen!
                                if fb2.handles[1] != 0 or fb2.pixel_format in (0x30334241, 0x30334258, 0x30335241, 0x30335258):
                                    needs_gbm = True
                                libdrm.drmModeFreeFB2(fb2_ptr)
                        except Exception:
                            pass
                    card_mons.append({
                        "name": cname,
                        "card": card_path,
                        "connector_id": int(conn_id),
                        "crtc_id": int(crtc_id),
                        "fb_id": int(crtc.buffer_id),
                        "mode_valid": int(crtc.mode_valid),
                        "x": int(crtc.x),
                        "y": int(crtc.y),
                        "width": w,
                        "height": h,
                        "needs_gbm": needs_gbm,
                    })
            os.close(fd)
            if card_mons:
                return card_path, card_mons
        except Exception:
            try:
                os.close(fd)
            except Exception:
                pass
    return None, []

def ensure_gbm_grab_binary():
    """
    Kompiliert bei Bedarf /tmp/lanview_gbm_grab_v1 (nutzt libdrm + libgbm + libturbojpeg),
    das 3-Plane Intel Gen12 CCS-komprimierte sowie 10-Bit (AB30/XB30) Framebuffer
    über den Mesa-GPU-Treiber artefaktfrei entpackt und per SIMD-TurboJPEG komprimiert.
    """
    bin_path = "/tmp/lanview_gbm_grab_v1"
    if os.path.isfile(bin_path) and os.access(bin_path, os.X_OK):
        return bin_path
    c_code = "\n".join([
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <stdint.h>",
        "#include <string.h>",
        "#include <fcntl.h>",
        "#include <unistd.h>",
        "#include <time.h>",
        "#include <xf86drm.h>",
        "#include <xf86drmMode.h>",
        "#include <gbm.h>",
        "#include <turbojpeg.h>",
        "int main(int argc, char **argv) {",
        "    if (argc < 7) return 1;",
        "    const char *card = argv[1];",
        "    uint32_t crtc_id = (uint32_t)atoi(argv[2]);",
        "    int fps = atoi(argv[3]);",
        "    int out_w = atoi(argv[4]);",
        "    int out_h = atoi(argv[5]);",
        "    int quality = atoi(argv[6]);",
        "    if (fps < 1) fps = 25;",
        "    int fd = open(card, O_RDWR | O_CLOEXEC);",
        "    if (fd < 0) return 1;",
        "    struct gbm_device *gbm = gbm_create_device(fd);",
        "    if (!gbm) return 1;",
        "    tjhandle tj = tjInitCompress();",
        "    if (!tj) return 1;",
        "    uint8_t *rgb = malloc((size_t)out_w * out_h * 4);",
        "    int *x_map = malloc(sizeof(int) * out_w);",
        "    uint64_t frame_us = 1000000ULL / (uint64_t)fps;",
        "    while (1) {",
        "        struct timespec t0, t1;",
        "        clock_gettime(CLOCK_MONOTONIC, &t0);",
        "        drmModeCrtc *crtc = drmModeGetCrtc(fd, crtc_id);",
        "        if (!crtc || !crtc->buffer_id) {",
        "            if (crtc) drmModeFreeCrtc(crtc);",
        "            usleep(40000);",
        "            continue;",
        "        }",
        "        uint32_t fb_id = crtc->buffer_id;",
        "        drmModeFreeCrtc(crtc);",
        "        drmModeFB2 *fb2 = drmModeGetFB2(fd, fb_id);",
        "        if (!fb2) { usleep(40000); continue; }",
        "        struct gbm_import_fd_modifier_data imp;",
        "        memset(&imp, 0, sizeof(imp));",
        "        imp.width = fb2->width;",
        "        imp.height = fb2->height;",
        "        imp.format = fb2->pixel_format;",
        "        imp.modifier = (fb2->flags & DRM_MODE_FB_MODIFIERS) ? fb2->modifier : 0ULL;",
        "        for (int i = 0; i < 4 && fb2->handles[i]; i++) {",
        "            int pfd = -1;",
        "            if (drmPrimeHandleToFD(fd, fb2->handles[i], DRM_CLOEXEC, &pfd) == 0 && pfd >= 0) {",
        "                imp.fds[i] = pfd;",
        "                imp.strides[i] = fb2->pitches[i];",
        "                imp.offsets[i] = fb2->offsets[i];",
        "                imp.num_fds = i + 1;",
        "            } else break;",
        "        }",
        "        struct gbm_bo *bo = NULL;",
        "        if (imp.num_fds > 0) {",
        "            if (fb2->flags & DRM_MODE_FB_MODIFIERS) {",
        "                bo = gbm_bo_import(gbm, GBM_BO_IMPORT_FD_MODIFIER, &imp, 0);",
        "            } else {",
        "                struct gbm_import_fd_data imp1 = { imp.fds[0], fb2->width, fb2->height, fb2->pitches[0], fb2->pixel_format };",
        "                bo = gbm_bo_import(gbm, GBM_BO_IMPORT_FD, &imp1, 0);",
        "            }",
        "        }",
        "        for (int i = 0; i < imp.num_fds; i++) if (imp.fds[i] >= 0) close(imp.fds[i]);",
        "        if (!bo) { drmModeFreeFB2(fb2); usleep(40000); continue; }",
        "        uint32_t stride = 0;",
        "        void *map_data = NULL;",
        "        void *ptr = gbm_bo_map(bo, 0, 0, fb2->width, fb2->height, GBM_BO_TRANSFER_READ, &stride, &map_data);",
        "        if (ptr) {",
        "            uint32_t sw = fb2->width, sh = fb2->height, fmt = fb2->pixel_format;",
        "            for (int x = 0; x < out_w; x++) x_map[x] = (int)((uint64_t)x * sw / out_w);",
        "            int is_10bit_bgr = (fmt == 0x30334241 || fmt == 0x30334258);",
        "            int is_10bit_rgb = (fmt == 0x30335241 || fmt == 0x30335258);",
        "            int is_8bit_bgr  = (fmt == 0x34324241 || fmt == 0x34324258);",
        "            for (int y = 0; y < out_h; y++) {",
        "                uint32_t sy = (uint32_t)((uint64_t)y * sh / out_h);",
        "                const uint32_t *src = (const uint32_t *)((const uint8_t *)ptr + (size_t)sy * stride);",
        "                uint8_t *dst = rgb + (size_t)y * out_w * 4;",
        "                if (is_10bit_bgr) {",
        "                    for (int x = 0; x < out_w; x++) {",
        "                        uint32_t v = src[x_map[x]];",
        "                        dst[x*4+0] = (v >> 2) & 0xFF; dst[x*4+1] = (v >> 12) & 0xFF; dst[x*4+2] = (v >> 22) & 0xFF; dst[x*4+3] = 255;",
        "                    }",
        "                } else if (is_10bit_rgb) {",
        "                    for (int x = 0; x < out_w; x++) {",
        "                        uint32_t v = src[x_map[x]];",
        "                        dst[x*4+0] = (v >> 22) & 0xFF; dst[x*4+1] = (v >> 12) & 0xFF; dst[x*4+2] = (v >> 2) & 0xFF; dst[x*4+3] = 255;",
        "                    }",
        "                } else if (is_8bit_bgr) {",
        "                    for (int x = 0; x < out_w; x++) {",
        "                        uint32_t v = src[x_map[x]];",
        "                        dst[x*4+0] = v & 0xFF; dst[x*4+1] = (v >> 8) & 0xFF; dst[x*4+2] = (v >> 16) & 0xFF; dst[x*4+3] = 255;",
        "                    }",
        "                } else {",
        "                    for (int x = 0; x < out_w; x++) {",
        "                        uint32_t v = src[x_map[x]];",
        "                        dst[x*4+0] = (v >> 16) & 0xFF; dst[x*4+1] = (v >> 8) & 0xFF; dst[x*4+2] = v & 0xFF; dst[x*4+3] = 255;",
        "                    }",
        "                }",
        "            }",
        "            gbm_bo_unmap(bo, map_data);",
        "            unsigned char *jpeg_buf = NULL;",
        "            unsigned long jpeg_size = 0;",
        "            if (tjCompress2(tj, rgb, out_w, 0, out_h, TJPF_RGBA, &jpeg_buf, &jpeg_size, TJSAMP_420, quality, TJFLAG_FASTDCT) == 0) {",
        "                size_t wr = fwrite(jpeg_buf, 1, jpeg_size, stdout);",
        "                fflush(stdout);",
        "                tjFree(jpeg_buf);",
        "                if (wr != jpeg_size) { gbm_bo_destroy(bo); drmModeFreeFB2(fb2); break; }",
        "            }",
        "        }",
        "        gbm_bo_destroy(bo);",
        "        drmModeFreeFB2(fb2);",
        "        clock_gettime(CLOCK_MONOTONIC, &t1);",
        "        uint64_t el = (uint64_t)(t1.tv_sec - t0.tv_sec) * 1000000ULL + (uint64_t)(t1.tv_nsec - t0.tv_nsec) / 1000ULL;",
        "        if (el < frame_us) usleep((useconds_t)(frame_us - el));",
        "    }",
        "    return 0;",
        "}",
    ])
    try:
        c_path = "/tmp/lanview_gbm_grab_v1.c"
        with open(c_path, "w", encoding="utf-8") as f:
            f.write(c_code)
        subprocess.run(
            ["gcc", "-O3", c_path, "-o", bin_path, "-I/usr/include/libdrm", "-ldrm", "-lgbm", "-lturbojpeg"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=6
        )
        if os.path.isfile(bin_path) and os.access(bin_path, os.X_OK):
            return bin_path
    except Exception:
        pass
    return None

def detect_x11_env():
    """Prüft, ob ein Xorg-Server läuft (z. B. SDDM oder X11-Session auf NVIDIA/ws4) und liefert (display, xauth)."""
    try:
        res = subprocess.run(["ps", "-ef"], capture_output=True, text=True, timeout=2)
        for line in res.stdout.splitlines():
            if "Xorg" in line and "-auth" in line:
                m_auth = re.search(r"-auth\s+(\S+)", line)
                m_disp = re.search(r"\s(:\d+)\s", line)
                xauth = m_auth.group(1) if m_auth else ""
                disp = m_disp.group(1) if m_disp else ":0"
                if xauth and os.path.exists(xauth):
                    return disp, xauth
    except Exception:
        pass
    return None, None

def ensure_headless_x11_output(disp: str, xauth: str):
    """
    Falls alle physischen Monitore ausgeschaltet sind (z. B. ws4 mit ausgeschaltetem Monitor),
    aktiviert dies einen Connector im Kernel/Xrandr auf 1920x1080, damit SDDM/Desktop sichtbar ist.
    """
    env = dict(os.environ, DISPLAY=disp, XAUTHORITY=xauth)
    try:
        # Prüfen, ob in sysfs überhaupt ein Connector 'connected' ist
        any_conn = False
        sys_drm = "/sys/class/drm"
        candidate_status = None
        if os.path.isdir(sys_drm):
            for entry in sorted(os.listdir(sys_drm)):
                st_path = os.path.join(sys_drm, entry, "status")
                if os.path.isfile(st_path):
                    with open(st_path, "r") as f:
                        st = f.read().strip()
                    if st == "connected":
                        any_conn = True
                    elif candidate_status is None and ("HDMI" in entry or "DP" in entry):
                        candidate_status = st_path
        if not any_conn and candidate_status:
            with open(candidate_status, "w") as f:
                f.write("on\n")
        subprocess.run(["xrandr", "--fb", "1920x1080"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
        xr = subprocess.run(["xrandr", "--query"], env=env, capture_output=True, text=True, timeout=2).stdout
        for line in xr.splitlines():
            if " connected" in line and "1920x1080" not in line:
                out_name = line.split()[0]
                subprocess.run(
                    ["xrandr", "--newmode", "1920x1080_60", "148.50", "1920", "2008", "2052", "2200", "1080", "1084", "1089", "1125", "+hsync", "+vsync"],
                    env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
                )
                subprocess.run(["xrandr", "--addmode", out_name, "1920x1080_60"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                subprocess.run(["xrandr", "--output", out_name, "--mode", "1920x1080_60", "--primary"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
                break
    except Exception:
        pass

def discover_drm_monitors(uinput=None):
    """Findet das aktive DRM-Device (/dev/dri/card*) und alle aktiven Monitore + CRTCs (inkl. X11/NVIDIA-Fallback)."""
    kscreen_map = get_kscreen_positions()
    x11_disp, x11_auth = detect_x11_env()
    chosen_card = None
    monitors = []

    for attempt in range(4):
        chosen_card, raw_mons = query_drm_state()
        if raw_mons:
            for m in raw_mons:
                cname = m["name"]
                if cname in kscreen_map:
                    m["x"] = kscreen_map[cname]["x"]
                    m["y"] = kscreen_map[cname]["y"]
                    m["width"] = kscreen_map[cname]["width"]
                    m["height"] = kscreen_map[cname]["height"]
                if x11_disp and x11_auth:
                    m["x11_display"] = x11_disp
                    m["x11_auth"] = x11_auth
            monitors = raw_mons
            threading.Thread(target=wake_screens, args=(uinput,), daemon=True).start()
            break
        if attempt == 0 and x11_disp and x11_auth:
            ensure_headless_x11_output(x11_disp, x11_auth)
        wake_screens(uinput)
        time.sleep(0.25)

    if not monitors and x11_disp and x11_auth:
        ensure_headless_x11_output(x11_disp, x11_auth)
        chosen_card = "x11"
        monitors = [{
            "name": "X11-0",
            "card": "x11",
            "connector_id": 1,
            "crtc_id": 1,
            "fb_id": 1,
            "mode_valid": 1,
            "x": 0,
            "y": 0,
            "width": 1920,
            "height": 1080,
            "x11_display": x11_disp,
            "x11_auth": x11_auth,
        }]

    monitors.sort(key=lambda m: (m["x"], m["y"], m["name"]))

    if len(monitors) > 1 and all(m["x"] == 0 and m["y"] == 0 for m in monitors):
        cur_x = 0
        for m in monitors:
            m["x"] = cur_x
            cur_x += m["width"]

    for idx, m in enumerate(monitors, 1):
        m["index"] = idx
        m["label"] = f"Monitor {idx}: {m['name']} ({m['width']}x{m['height']} @ {m['x']},{m['y']})"

    total_w = max((m["x"] + m["width"] for m in monitors), default=1920)
    total_h = max((m["y"] + m["height"] for m in monitors), default=1080)
    return chosen_card, monitors, total_w, total_h


# --- 2. Kernel /dev/uinput Maus & Tastatur ---
UI_SET_EVBIT   = 0x40045564
UI_SET_KEYBIT  = 0x40045565
UI_SET_RELBIT  = 0x40045566
UI_SET_ABSBIT  = 0x40045567
UI_DEV_CREATE  = 0x5501
UI_DEV_DESTROY = 0x5502

EV_SYN = 0x00
EV_KEY = 0x01
EV_REL = 0x02
EV_ABS = 0x03

ABS_X = 0x00
ABS_Y = 0x01
REL_WHEEL  = 0x08
REL_HWHEEL = 0x06

BTN_LEFT   = 0x110
BTN_RIGHT  = 0x111
BTN_MIDDLE = 0x112
BTN_SIDE   = 0x113
BTN_EXTRA  = 0x114

def ensure_uinput_module():
    """Stellt sicher, dass /dev/uinput geöffnet werden kann (lädt Modul ggf. auch nach Kernel-Update aus Pacman-Cache)."""
    try:
        fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        os.close(fd)
        return
    except Exception:
        pass
    subprocess.run(["modprobe", "uinput"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        os.close(fd)
        return
    except Exception:
        pass
    try:
        kver = os.uname().release
        mod_rel = f"usr/lib/modules/{kver}/kernel/drivers/input/misc/uinput.ko.zst"
        pkg_dir = "/var/cache/pacman/pkg"
        if os.path.isdir(pkg_dir):
            for fn in os.listdir(pkg_dir):
                if fn.startswith(f"linux-{kver.replace('-arch', '.arch')}") and fn.endswith(".pkg.tar.zst"):
                    pkg_path = os.path.join(pkg_dir, fn)
                    subprocess.run(["tar", "-xf", pkg_path, "-C", "/", mod_rel], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
                    ko_zst = "/" + mod_rel
                    if os.path.isfile(ko_zst):
                        subprocess.run(["zstd", "-d", "-f", ko_zst, "-o", "/tmp/uinput.ko"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
                        subprocess.run(["insmod", "/tmp/uinput.ko"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
                        try:
                            os.remove("/tmp/uinput.ko")
                        except Exception:
                            pass
                    break
    except Exception:
        pass


class UInputController:
    def __init__(self):
        self.ptr_fd = None
        self.kbd_fd = None
        ensure_uinput_module()
        try:
            self._init_pointer()
            self._init_keyboard()
        except Exception:
            self.ptr_fd = None
            self.kbd_fd = None

    def _init_pointer(self):
        self.ptr_fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        for ev in (EV_SYN, EV_KEY, EV_ABS, EV_REL):
            fcntl.ioctl(self.ptr_fd, UI_SET_EVBIT, ev)
        for btn in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE, BTN_SIDE, BTN_EXTRA):
            fcntl.ioctl(self.ptr_fd, UI_SET_KEYBIT, btn)
        for axis in (ABS_X, ABS_Y):
            fcntl.ioctl(self.ptr_fd, UI_SET_ABSBIT, axis)
        for rel in (REL_WHEEL, REL_HWHEEL):
            fcntl.ioctl(self.ptr_fd, UI_SET_RELBIT, rel)

        name = b"lanview-abs-pointer" + b"\x00" * (80 - 19)
        id_struct = struct.pack("HHHH", 0x03, 0x1234, 0x5678, 1)
        absmax = [0] * 64
        absmin = [0] * 64
        absfuzz = [0] * 64
        absflat = [0] * 64
        absmax[ABS_X] = 65535
        absmax[ABS_Y] = 65535
        udev = (
            name + id_struct + struct.pack("I", 0)
            + struct.pack("64i", *absmax)
            + struct.pack("64i", *absmin)
            + struct.pack("64i", *absfuzz)
            + struct.pack("64i", *absflat)
        )
        os.write(self.ptr_fd, udev)
        fcntl.ioctl(self.ptr_fd, UI_DEV_CREATE)

    def _init_keyboard(self):
        self.kbd_fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        for ev in (EV_SYN, EV_KEY):
            fcntl.ioctl(self.kbd_fd, UI_SET_EVBIT, ev)
        for k in range(1, 248):
            fcntl.ioctl(self.kbd_fd, UI_SET_KEYBIT, k)

        name = b"lanview-keyboard" + b"\x00" * (80 - 16)
        id_struct = struct.pack("HHHH", 0x03, 0x1234, 0x5679, 1)
        zeros = [0] * 64
        udev = (
            name + id_struct + struct.pack("I", 0)
            + struct.pack("64i", *zeros)
            + struct.pack("64i", *zeros)
            + struct.pack("64i", *zeros)
            + struct.pack("64i", *zeros)
        )
        os.write(self.kbd_fd, udev)
        fcntl.ioctl(self.kbd_fd, UI_DEV_CREATE)

    def _emit(self, fd, ev_type, code, val):
        if fd is not None:
            os.write(fd, struct.pack("llHHi", 0, 0, ev_type, code, int(val)))

    def move_abs(self, global_x: float, global_y: float, total_w: int, total_h: int):
        ax = max(0, min(65535, int(global_x * 65535 / max(1, total_w))))
        ay = max(0, min(65535, int(global_y * 65535 / max(1, total_h))))
        self._emit(self.ptr_fd, EV_ABS, ABS_X, ax)
        self._emit(self.ptr_fd, EV_ABS, ABS_Y, ay)
        self._emit(self.ptr_fd, EV_SYN, 0, 0)

    def button(self, btn_code: int, pressed: bool):
        self._emit(self.ptr_fd, EV_KEY, btn_code, 1 if pressed else 0)
        self._emit(self.ptr_fd, EV_SYN, 0, 0)

    def wheel(self, dy: int, dx: int = 0):
        if dy != 0:
            self._emit(self.ptr_fd, EV_REL, REL_WHEEL, dy)
        if dx != 0:
            self._emit(self.ptr_fd, EV_REL, REL_HWHEEL, dx)
        self._emit(self.ptr_fd, EV_SYN, 0, 0)

    def key(self, evdev_code: int, pressed: bool):
        if 1 <= evdev_code <= 247:
            self._emit(self.kbd_fd, EV_KEY, evdev_code, 1 if pressed else 0)
            self._emit(self.kbd_fd, EV_SYN, 0, 0)

    def close(self):
        for fd in (self.ptr_fd, self.kbd_fd):
            if fd is not None:
                try:
                    fcntl.ioctl(fd, UI_DEV_DESTROY)
                except Exception:
                    pass
                try:
                    os.close(fd)
                except Exception:
                    pass


# --- 3. Zero-Lag Streamer mit Backpressure & Login-/Modeset-Watchdog ---
class StreamWorker:
    def __init__(self, card_path, monitors, total_w, total_h, uinput=None):
        self.card_path = card_path
        self.monitors = monitors
        self.total_w = total_w
        self.total_h = total_h
        self.uinput = uinput
        self.current_mon = monitors[0] if monitors else None
        self.fps = 30
        self.scale_pct = 100
        self.quality = 80
        self.proc = None
        self.stop_event = threading.Event()
        self.lock = threading.Lock()

        # Credit-basierte Flusskontrolle (verhindert jeglichen Buffer-Stau in SSH/TCP!)
        self.cond = threading.Condition()
        self.credits = 2
        self.latest_frame = None   # (seq, mon_index, jpeg_bytes, digest)
        self.frame_seq = 0
        self.sent_seq = 0
        self.last_capture_ts = time.time()
        self.force_next_frame = True
        self.probing_modes = False
        self.working_mode_by_mon = {}
        self.gbm_grab_bin = ensure_gbm_grab_binary()

        self.sender_thread = threading.Thread(target=self._sender_loop, daemon=True)
        self.sender_thread.start()

        self.watchdog_thread = threading.Thread(target=self._drm_watchdog_loop, daemon=True)
        self.watchdog_thread.start()

    def on_client_ack(self):
        with self.cond:
            self.credits = min(3, self.credits + 1)
            self.cond.notify_all()

    def notify_user_input(self):
        """Erzwingt nach Tastatur-/Mauseingaben sofortiges Senden neuer Frames."""
        with self.cond:
            self.force_next_frame = True
            self.cond.notify_all()

    def start_stream(self, mon_index=None, fps=None, scale_pct=None, quality=None, force_restart=False):
        with self.lock:
            target_mon = self.current_mon
            if mon_index is not None:
                for m in self.monitors:
                    if m["index"] == mon_index:
                        target_mon = m
                        break
            new_fps = max(5, min(60, int(fps))) if fps is not None else self.fps
            new_scale = max(25, min(100, int(scale_pct))) if scale_pct is not None else self.scale_pct
            new_qual = max(30, min(95, int(quality))) if quality is not None else self.quality

            if (
                not force_restart
                and self.proc is not None
                and self.proc.poll() is None
                and self.current_mon is not None
                and target_mon is not None
                and self.current_mon["index"] == target_mon["index"]
                and new_fps == self.fps
                and new_scale == self.scale_pct
                and new_qual == self.quality
            ):
                return

            self._stop_current()
            self.current_mon = target_mon
            self.fps = new_fps
            self.scale_pct = new_scale
            self.quality = new_qual

            if not self.current_mon:
                return

            with self.cond:
                self.latest_frame = None
                self.credits = 2
                self.force_next_frame = True
                self.cond.notify_all()

            self.stop_event = threading.Event()
            t = threading.Thread(target=self._capture_loop, args=(self.stop_event, dict(self.current_mon)), daemon=True)
            t.start()

    def _stop_current(self):
        self.stop_event.set()
        if self.proc:
            p = self.proc
            self.proc = None
            try:
                p.kill()  # Sofort beenden (< 1ms) statt 1s zu warten -> schneller Monitorwechsel!
                p.wait(timeout=0.2)
            except Exception:
                pass

    def _build_ffmpeg_cmd(self, mon, mode="vaapi_hw"):
        out_w = max(640, (int(mon["width"] * self.scale_pct / 100) // 2) * 2)
        out_h = max(360, (int(mon["height"] * self.scale_pct / 100) // 2) * 2)
        q_val = max(2, min(20, int((100 - self.quality) / 4)))
        if mode == "gbm_grab":
            return [
                self.gbm_grab_bin,
                mon["card"],
                str(mon["crtc_id"]),
                str(self.fps),
                str(out_w),
                str(out_h),
                str(self.quality),
            ]
        elif mode == "x11grab":
            disp = mon.get("x11_display") or ":0"
            mx, my = int(mon.get("x", 0)), int(mon.get("y", 0))
            mw, mh = int(mon.get("width", 1920)), int(mon.get("height", 1080))
            return [
                "ffmpeg", "-hide_banner", "-loglevel", "error",
                "-fflags", "nobuffer", "-flags", "low_delay",
                "-f", "x11grab",
                "-framerate", str(self.fps),
                "-video_size", f"{mw}x{mh}",
                "-i", f"{disp}+{mx},{my}",
                "-vf", f"scale=w={out_w}:h={out_h}",
                "-c:v", "mjpeg",
                "-q:v", str(q_val),
                "-f", "image2pipe", "-"
            ]
        elif mode == "vaapi_hw":
            return [
                "ffmpeg", "-hide_banner", "-loglevel", "error",
                "-fflags", "nobuffer", "-flags", "low_delay",
                "-device", mon["card"],
                "-crtc_id", str(mon["crtc_id"]),
                "-framerate", str(self.fps),
                "-f", "kmsgrab", "-i", "-",
                "-vf", f"hwmap=derive_device=vaapi,scale_vaapi=w={out_w}:h={out_h}:format=nv12",
                "-c:v", "mjpeg_vaapi",
                "-global_quality", str(self.quality),
                "-f", "image2pipe", "-"
            ]
        elif mode == "vaapi_sw":
            return [
                "ffmpeg", "-hide_banner", "-loglevel", "error",
                "-fflags", "nobuffer", "-flags", "low_delay",
                "-device", mon["card"],
                "-crtc_id", str(mon["crtc_id"]),
                "-framerate", str(self.fps),
                "-f", "kmsgrab", "-i", "-",
                "-vf", f"hwmap=derive_device=vaapi,scale_vaapi=w={out_w}:h={out_h}:format=nv12,hwdownload,format=nv12",
                "-c:v", "mjpeg",
                "-q:v", str(q_val),
                "-f", "image2pipe", "-"
            ]
        else:
            return [
                "ffmpeg", "-hide_banner", "-loglevel", "error",
                "-fflags", "nobuffer", "-flags", "low_delay",
                "-device", mon["card"],
                "-crtc_id", str(mon["crtc_id"]),
                "-framerate", str(self.fps),
                "-f", "kmsgrab", "-i", "-",
                "-vf", f"hwdownload,format=bgr0,scale=w={out_w}:h={out_h}",
                "-c:v", "mjpeg",
                "-q:v", str(q_val),
                "-f", "image2pipe", "-"
            ]

    def _capture_loop(self, stop_ev: threading.Event, mon: dict):
        mon_idx = mon["index"]
        if mon.get("card") == "x11":
            modes = ["x11grab"]
        else:
            if mon.get("needs_gbm") and self.gbm_grab_bin:
                base_modes = ["gbm_grab", "vaapi_hw", "vaapi_sw", "sw"]
            elif self.gbm_grab_bin:
                base_modes = ["vaapi_hw", "gbm_grab", "vaapi_sw", "sw"]
            else:
                base_modes = ["vaapi_hw", "vaapi_sw", "sw"]
            if mon.get("x11_display") and mon.get("x11_auth"):
                base_modes.append("x11grab")
            pref = self.working_mode_by_mon.get(mon_idx)
            if pref and pref in base_modes:
                modes = [pref] + [m for m in base_modes if m != pref]
            else:
                modes = base_modes

        self.probing_modes = True
        for mode in modes:
            if stop_ev.is_set():
                self.probing_modes = False
                return
            self.last_capture_ts = time.time()
            cmd = self._build_ffmpeg_cmd(mon, mode=mode)
            env = dict(os.environ)
            if mode == "x11grab":
                if mon.get("x11_display"):
                    env["DISPLAY"] = mon["x11_display"]
                if mon.get("x11_auth"):
                    env["XAUTHORITY"] = mon["x11_auth"]

            try:
                proc = subprocess.Popen(
                    cmd,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    env=env,
                    bufsize=65536
                )
                self.proc = proc
            except Exception as e:
                send_json({"type": "error", "message": f"ffmpeg Startfehler: {e}"})
                self.probing_modes = False
                return

            buf = bytearray()
            got_valid_frame = False
            stdout_pipe = proc.stdout
            while not stop_ev.is_set():
                chunk = stdout_pipe.read(32768)
                if not chunk:
                    break
                buf.extend(chunk)
                while True:
                    soi = buf.find(b"\xff\xd8")
                    if soi == -1:
                        buf.clear()
                        break
                    if soi > 0:
                        del buf[:soi]
                    eoi = buf.find(b"\xff\xd9", 2)
                    if eoi == -1:
                        break
                    frame = bytes(buf[:eoi + 2])
                    del buf[:eoi + 2]
                    # Falls auf Dual-GPU-Systemen (z. B. ws4 mit NVIDIA Xorg + leerer Intel-CRTC)
                    # kmsgrab nur ein winziges komplett schwarzes Dummy-Frame (< 2500 Bytes) liefert
                    # und X11 verfügbar ist, auf x11grab wechseln:
                    if not got_valid_frame and len(frame) < 2500 and mode != "x11grab" and "x11grab" in modes:
                        try:
                            proc.kill()
                        except Exception:
                            pass
                        buf.clear()
                        break
                    got_valid_frame = True
                    self.probing_modes = False
                    self.working_mode_by_mon[mon_idx] = mode
                    self.last_capture_ts = time.time()
                    dg = hashlib.md5(frame[::16]).digest()
                    with self.cond:
                        self.frame_seq += 1
                        self.latest_frame = (self.frame_seq, mon_idx, frame, dg)
                        self.cond.notify_all()
                if not got_valid_frame and proc.poll() is not None and not buf:
                    break

            if got_valid_frame or stop_ev.is_set():
                break

        self.probing_modes = False
        if not stop_ev.is_set():
            wake_screens(self.uinput)

    def _sender_loop(self):
        last_digest = None
        last_sent_time = 0.0
        last_mon_sent = None

        while True:
            with self.cond:
                while (
                    self.latest_frame is None
                    or self.latest_frame[0] <= self.sent_seq
                    or self.credits <= 0
                ):
                    self.cond.wait(timeout=0.5)
                    # Sicherheits-Fallback falls ein ACK ausblieb
                    if time.time() - last_sent_time > 0.6 and self.credits <= 0:
                        self.credits = 1

                seq, mon_idx, frame, dg = self.latest_frame
                now = time.time()
                # Wenn sich das Bild überhaupt nicht verändert hat und kein Monitorwechsel/Input vorlag:
                # max. alle 0.4s ein Keepalive-Frame senden -> spart 90% Bandbreite im Standbild!
                if (
                    dg == last_digest
                    and mon_idx == last_mon_sent
                    and not self.force_next_frame
                    and (now - last_sent_time) < 0.4
                ):
                    self.sent_seq = seq
                    continue

                self.sent_seq = seq
                self.credits -= 1
                self.force_next_frame = False
                last_digest = dg
                last_mon_sent = mon_idx
                last_sent_time = now

            try:
                send_frame(mon_idx, frame)
            except Exception:
                break

    def _drm_watchdog_loop(self):
        """
        Überwacht DRM/CRTC-Änderungen (z. B. beim Anmelden/Login in SDDM/KScreenLocker,
        Auflösungswechsel oder kurzem Modeset) und startet ffmpeg bei Bedarf nahtlos neu.
        """
        last_fb_id = None
        last_crtc_id = None
        zero_fb_seen = False

        while True:
            time.sleep(0.75)
            if self.probing_modes:
                continue
            cur_mon = self.current_mon
            if not cur_mon or cur_mon.get("card") == "x11":
                continue

            _, raw_mons = query_drm_state(card_filter=cur_mon["card"])
            if not raw_mons:
                zero_fb_seen = True
                continue

            matched = None
            for rm in raw_mons:
                if rm["name"] == cur_mon["name"]:
                    matched = rm
                    break

            if not matched:
                continue

            cur_crtc = matched["crtc_id"]
            cur_fb = matched["fb_id"]
            stall_sec = time.time() - self.last_capture_ts

            # Fall 1: CRTC-ID hat sich beim Login/Session-Wechsel geändert
            # Fall 2: Monitor war kurz auf fb_id=0 (Modeset beim Login) und ist wieder da
            # Fall 3: ffmpeg liefert seit > 1.0s keine Frames mehr oder Prozess hat sich beendet
            proc_dead = (self.proc is not None and self.proc.poll() is not None)
            need_restart = False

            if last_crtc_id is not None and cur_crtc != last_crtc_id:
                need_restart = True
            elif zero_fb_seen and cur_fb != 0:
                need_restart = True
                zero_fb_seen = False
            elif cur_fb == 0:
                zero_fb_seen = True
            elif proc_dead or stall_sec > 1.2:
                need_restart = True

            # Auch prüfen, ob sich der Framebuffer nach Tastatureingabe geändert hat,
            # während kmsgrab noch am alten Buffer hing
            if last_fb_id is not None and cur_fb != 0 and cur_fb != last_fb_id and stall_sec > 0.45:
                need_restart = True

