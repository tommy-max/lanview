def load_station_configs() -> list:
    """
    Lädt alle einzelnen Maschinen-Konfigurationsdateien (*.json) aus ~/.config/lanview/stations/.
    Keine fest codierten Stationen im Programmcode!
    """
    stations = []
    if not os.path.isdir(STATIONS_CONFIG_DIR):
        return stations

    for fname in sorted(os.listdir(STATIONS_CONFIG_DIR)):
        if not fname.endswith(".json"):
            continue
        fpath = os.path.join(STATIONS_CONFIG_DIR, fname)
        if not os.path.isfile(fpath):
            continue
        try:
            with open(fpath, "r", encoding="utf-8") as f:
                data = json.load(f)
            if not isinstance(data, dict):
                continue
            st_id = str(data.get("id") or os.path.splitext(fname)[0]).strip()
            host = str(data.get("host") or st_id).strip()
            ip = str(data.get("ip") or "").strip()
            name = str(data.get("name") or st_id.upper()).strip()
            desc = str(data.get("description") or "").strip()
            user = str(data.get("user") or "").strip()
            ssh_key = str(data.get("ssh_key") or "").strip()
            sudo_pass = str(data.get("sudo_pass") or "")
            default_fps = int(data.get("default_fps") or 30)
            raw_scale = data.get("default_scale", 100)
            if isinstance(raw_scale, float) and raw_scale <= 1.0:
                default_scale = int(round(raw_scale * 100))
            else:
                default_scale = int(raw_scale)

            stations.append({
                "id": st_id,
                "name": name,
                "description": desc,
                "host": host,
                "ip": ip,
                "user": user,
                "ssh_key": ssh_key,
                "sudo_pass": sudo_pass,
                "default_fps": default_fps,
                "default_scale": default_scale,
                "config_file": fpath,
                "config_filename": fname,
            })
        except Exception:
            continue

    def natural_key(st):
        m = re.match(r"^([a-zA-Z]+)(\d+)$", st["id"])
        if m:
            return (0, m.group(1).lower(), int(m.group(2)))
        return (1, st["id"].lower(), 0)

    return sorted(stations, key=natural_key)


class SSHStreamThread(QThread):
    frame_received = pyqtSignal(int, QImage, int)  # (mon_index, image, byte_len)
    init_received = pyqtSignal(dict)
    status_received = pyqtSignal(str)
    error_received = pyqtSignal(str)
    disconnected = pyqtSignal()

    def __init__(self, target_host: str, sudo_pass: str = "", user: str = "", ssh_key: str = ""):
        super().__init__()
        self.target_host = target_host
        self.sudo_pass = sudo_pass
        self.user = user
        self.ssh_key = os.path.expanduser(ssh_key) if ssh_key else ""
        self.proc = None
        self.running = True
        self.write_lock = threading.Lock()

    def run(self):
        self.status_received.emit(f"Verbinde per SSH mit {self.target_host} ...")
        compressed = zlib.compress(REMOTE_AGENT_CODE.encode("utf-8"), 9)
        b64_agent = base64.b64encode(compressed).decode("ascii")
        py_exec = f"import base64,zlib; exec(zlib.decompress(base64.b64decode('{b64_agent}')).decode('utf-8'))"
        q_py = shlex.quote(py_exec)
        q_pw = shlex.quote(self.sudo_pass)

        remote_cmd = (
            f"PY_CODE={q_py}; "
            f"if [ \"$(id -u)\" -eq 0 ]; then "
            f"  exec python3 -u -c \"$PY_CODE\"; "
            f"elif sudo -n true 2>/dev/null; then "
            f"  exec sudo -E python3 -u -c \"$PY_CODE\"; "
            f"else "
            f"  (printf '%s\\n' {q_pw}; cat) | sudo -S -p '' -E python3 -u -c \"$PY_CODE\"; "
            f"fi"
        )

        ssh_cmd = [
            "ssh",
            "-o", "ConnectTimeout=8",
            "-o", "ServerAliveInterval=15",
            "-o", "ServerAliveCountMax=3",
            "-o", "Compression=no",
        ]
        if self.ssh_key and os.path.isfile(self.ssh_key):
            ssh_cmd.extend(["-i", self.ssh_key])
        if self.user and "@" not in self.target_host:
            ssh_cmd.extend(["-l", self.user])
        ssh_cmd.extend([self.target_host, remote_cmd])

        try:
            self.proc = subprocess.Popen(
                ssh_cmd,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                bufsize=0
            )
        except Exception as e:
            self.error_received.emit(f"SSH konnte nicht gestartet werden: {e}")
            self.disconnected.emit()
            return

        stderr_lines = []
        def read_stderr():
            try:
                for line in self.proc.stderr:
                    txt = line.decode("utf-8", errors="replace").strip()
                    if txt:
                        stderr_lines.append(txt)
            except Exception:
                pass

        threading.Thread(target=read_stderr, daemon=True).start()

        stdout = self.proc.stdout
        try:
            while self.running:
                hdr = self._read_exact(stdout, 8)
                if not hdr:
                    break
                magic = hdr[:4]
                length = struct.unpack(">I", hdr[4:8])[0]
                if length > 25_000_000 or length < 1:
                    break
                payload = self._read_exact(stdout, length)
                if not payload:
                    break

                if magic == b"LVFR":
                    # Sofort ACK zurückschicken, damit der Server den nächsten Frame frei hat
                    self.send_cmd({"t": "ack"})
                    mon_idx = payload[0]
                    jpeg_data = payload[1:]
                    img = QImage.fromData(jpeg_data, "JPEG")
                    if not img.isNull():
                        self.frame_received.emit(mon_idx, img, len(jpeg_data))
                elif magic == b"LVJS":
                    try:
                        msg = json.loads(payload.decode("utf-8", errors="replace"))
                        mtype = msg.get("type")
                        if mtype == "init":
                            self.init_received.emit(msg)
                        elif mtype == "error":
                            self.error_received.emit(msg.get("message", "Unbekannter Remote-Fehler"))
                    except Exception:
                        pass
        except Exception as e:
            if self.running:
                self.error_received.emit(f"Stream-Verbindungsfehler: {e}")
        finally:
            self.stop()
            if stderr_lines and self.running:
                err_tail = "\n".join(stderr_lines[-5:])
                if "password" not in err_tail.lower():
                    self.status_received.emit(f"Beendet ({err_tail})")
            self.disconnected.emit()

    def _read_exact(self, stream, n: int) -> bytes:
        buf = bytearray()
        while len(buf) < n and self.running:
            chunk = stream.read(n - len(buf))
            if not chunk:
                return b""
            buf.extend(chunk)
        return bytes(buf)

    def send_cmd(self, obj: dict):
        if not self.proc or not self.proc.stdin or not self.running:
            return
        try:
            line = (json.dumps(obj, separators=(",", ":")) + "\n").encode("utf-8")
            with self.write_lock:
                self.proc.stdin.write(line)
                self.proc.stdin.flush()
        except Exception:
            pass

    def stop(self):
        self.running = False
        if self.proc:
            try:
                self.send_cmd({"t": "quit"})
            except Exception:
                pass
            try:
                self.proc.terminate()
            except Exception:
                pass
            self.proc = None


class VideoCanvas(QWidget):
    """Zeigt das Live-Bild des gewählten Monitors inkl. Ladeanimation beim Monitorwechsel."""

    def __init__(self, parent_win):
        super().__init__(parent_win)
        self.parent_win = parent_win
        self.current_image = None
        self.setMouseTracking(True)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.setStyleSheet("background-color: #0f172a;")
        self._last_move_sent = 0.0

        # Ladeanimation (Spinner) für Verbindungsaufbau & Monitorwechsel
        self.loading_active = False
        self.loading_text = ""
        self.spinner_angle = 0
        self.spinner_timer = QTimer(self)
        self.spinner_timer.timeout.connect(self._tick_spinner)

    def start_loading(self, text: str):
        self.loading_active = True
        self.loading_text = text
        self.spinner_angle = 0
        if not self.spinner_timer.isActive():
            self.spinner_timer.start(30)
        self.update()

    def stop_loading(self):
        if self.loading_active:
            self.loading_active = False
            self.spinner_timer.stop()
            self.update()

    def _tick_spinner(self):
        self.spinner_angle = (self.spinner_angle + 18) % 360
        self.update()

    def update_frame(self, img: QImage):
        self.current_image = img
        if self.loading_active:
            self.stop_loading()
        else:
            self.update()

    def clear_frame(self):
        self.current_image = None
        self.stop_loading()
        self.update()

    def _get_target_rect(self):
        if not self.current_image or self.current_image.isNull():
            return None
        ww, wh = self.width(), self.height()
        iw, ih = self.current_image.width(), self.current_image.height()
        if ww <= 0 or wh <= 0 or iw <= 0 or ih <= 0:
            return None
        scale = min(ww / iw, wh / ih)
        tw, th = int(iw * scale), int(ih * scale)
        tx = (ww - tw) // 2
        ty = (wh - th) // 2
        return (tx, ty, tw, th)

    def _map_pos_to_normalized(self, pos):
        rect = self._get_target_rect()
        if not rect:
            return None
        tx, ty, tw, th = rect
        if tw <= 0 or th <= 0:
            return None
        rx = (pos.x() - tx) / tw
        ry = (pos.y() - ty) / th
        rx = max(0.0, min(1.0, rx))
        ry = max(0.0, min(1.0, ry))
        return rx, ry

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        painter.fillRect(self.rect(), QColor("#0f172a"))

        if self.current_image and not self.current_image.isNull():
            rect = self._get_target_rect()
            if rect:
                tx, ty, tw, th = rect
                painter.drawImage(tx, ty, self.current_image.scaled(
                    tw, th, Qt.AspectRatioMode.IgnoreAspectRatio, Qt.TransformationMode.SmoothTransformation
                ))
        elif not self.loading_active:
            painter.setPen(QColor("#94a3b8"))
            font = QFont("Sans Serif", 13)
            painter.setFont(font)
            painter.drawText(
                self.rect(),
                Qt.AlignmentFlag.AlignCenter,
                "Keine aktive Verbindung.\nWähle oben eine Station oder IP-Adresse und klicke auf 'Verbinden'."
            )

        # Lade-Overlay mit animiertem Dreh-Spinner bei Monitorwechsel / Verbindungsaufbau
        if self.loading_active:
            painter.fillRect(self.rect(), QColor(15, 23, 42, 175))
            cx = self.width() / 2.0
            cy = self.height() / 2.0 - 18.0
            radius = 26.0

            # Hintergrund-Ring
            bg_pen = QPen(QColor(71, 85, 105, 120), 4.5)
            painter.setPen(bg_pen)
            painter.drawEllipse(QRectF(cx - radius, cy - radius, radius * 2, radius * 2))

            # Rotierender Bogen
            arc_pen = QPen(QColor("#f59e0b"), 4.5)
            arc_pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            painter.setPen(arc_pen)
            painter.drawArc(
                QRectF(cx - radius, cy - radius, radius * 2, radius * 2),
                int(-self.spinner_angle * 16),
                int(110 * 16)
            )

            # Text unter dem Spinner
            painter.setPen(QColor("#f8fafc"))
            font = QFont("Sans Serif", 12, QFont.Weight.Bold)
            painter.setFont(font)
            text_rect = QRectF(0, cy + radius + 14, self.width(), 40)
            painter.drawText(text_rect, Qt.AlignmentFlag.AlignHCenter | Qt.AlignmentFlag.AlignTop, self.loading_text)

    def mouseMoveEvent(self, event: QMouseEvent):
        if not self.parent_win.is_control_enabled():
            return
        coords = self._map_pos_to_normalized(event.position())
        if not coords:
            return
        now = time.time()
        if now - self._last_move_sent >= 0.012:
            self._last_move_sent = now
            self.parent_win.send_mouse_move(coords[0], coords[1])

    def mousePressEvent(self, event: QMouseEvent):
        self.setFocus()
        if not self.parent_win.is_control_enabled():
            return
        coords = self._map_pos_to_normalized(event.position())
        btn = self._qt_btn_to_code(event.button())
        if btn and coords:
            self.parent_win.send_mouse_button(btn, True, coords[0], coords[1])

    def mouseReleaseEvent(self, event: QMouseEvent):
        if not self.parent_win.is_control_enabled():
            return
        coords = self._map_pos_to_normalized(event.position())
        btn = self._qt_btn_to_code(event.button())
        if btn and coords:
            self.parent_win.send_mouse_button(btn, False, coords[0], coords[1])

    def wheelEvent(self, event: QWheelEvent):
        if not self.parent_win.is_control_enabled():
            return
        delta_y = event.angleDelta().y()
        delta_x = event.angleDelta().x()
        dy = 1 if delta_y > 0 else (-1 if delta_y < 0 else 0)
        dx = 1 if delta_x > 0 else (-1 if delta_x < 0 else 0)
        if dy or dx:
            self.parent_win.send_mouse_wheel(dy, dx)

    def keyPressEvent(self, event: QKeyEvent):
        if event.key() == Qt.Key.Key_F and (event.modifiers() & Qt.KeyboardModifier.ControlModifier) and (event.modifiers() & Qt.KeyboardModifier.AltModifier):
            self.parent_win.toggle_fullscreen()
            event.accept()
            return

        if not self.parent_win.is_control_enabled():
            return
        if event.isAutoRepeat():
            return
        evdev_code = event.nativeScanCode() - 8
        if 1 <= evdev_code <= 247:
            self.parent_win.send_key(evdev_code, True)
            event.accept()

    def keyReleaseEvent(self, event: QKeyEvent):
        if not self.parent_win.is_control_enabled():
            return
        if event.isAutoRepeat():
            return
        evdev_code = event.nativeScanCode() - 8
        if 1 <= evdev_code <= 247:
            self.parent_win.send_key(evdev_code, False)
            event.accept()

    @staticmethod
    def _qt_btn_to_code(btn):
        if btn == Qt.MouseButton.LeftButton:
            return 1
        if btn == Qt.MouseButton.RightButton:
            return 2
        if btn == Qt.MouseButton.MiddleButton:
            return 3
        if btn == Qt.MouseButton.BackButton:
            return 4
        if btn == Qt.MouseButton.ForwardButton:
            return 5
        return 0


