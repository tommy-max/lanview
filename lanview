    def _build_selector_page(self) -> QWidget:
        page = QWidget(self)
        page.setStyleSheet("background-color: #0f172a;")
        outer = QVBoxLayout(page)
        outer.setContentsMargins(40, 32, 40, 32)
        outer.setSpacing(18)

        header_row = QHBoxLayout()
        title_col = QVBoxLayout()
        title_col.setSpacing(4)

        h1 = QLabel("Maschine auswählen", page)
        h1.setStyleSheet("color: #f8fafc; font-size: 22px; font-weight: 800;")
        title_col.addWidget(h1)

        sub = QLabel(
            f"Jede Station wird als eigene Konfigurationsdatei aus {STATIONS_CONFIG_DIR} (*.json) geladen:",
            page
        )
        sub.setStyleSheet("color: #94a3b8; font-size: 13px;")
        title_col.addWidget(sub)
        header_row.addLayout(title_col, 1)

        reload_btn = QPushButton("↻ Configs neu laden", page)
        reload_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        reload_btn.setStyleSheet("""
            QPushButton {
                background-color: #1e293b;
                color: #e2e8f0;
                border: 1px solid #475569;
                border-radius: 6px;
                padding: 8px 14px;
                font-size: 12px;
                font-weight: 600;
            }
            QPushButton:hover {
                background-color: #334155;
            }
        """)
        reload_btn.clicked.connect(self.reload_stations)
        header_row.addWidget(reload_btn, 0, Qt.AlignmentFlag.AlignTop)
        outer.addLayout(header_row)

        scroll = QScrollArea(page)
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        scroll.setStyleSheet("QScrollArea { background-color: transparent; border: none; }")

        self.cards_container = QWidget(scroll)
        self.cards_container.setStyleSheet("background-color: transparent;")
        self.cards_layout = QVBoxLayout(self.cards_container)
        self.cards_layout.setContentsMargins(0, 4, 0, 4)
        self.cards_layout.setSpacing(12)
        self.cards_layout.addStretch(1)

        scroll.setWidget(self.cards_container)
        outer.addWidget(scroll, 1)
        return page

    def reload_stations(self):
        self.stations = load_station_configs()
        self.station_map = {}

        # Dropdown aktualisieren
        current_txt = self.host_combo.currentText().strip()
        self.host_combo.blockSignals(True)
        self.host_combo.clear()
        self.host_combo.addItem("— Bitte Maschine wählen —", "")
        for st in self.stations:
            self.station_map[st["id"].lower()] = st
            self.station_map[st["host"].lower()] = st
            if st.get("ip"):
                self.station_map[st["ip"].lower()] = st
            label = f"{st['id'].upper()} – {st['name']}"
            if st.get("ip"):
                label += f" ({st['ip']})"
            self.host_combo.addItem(label, st["id"])
        self.host_combo.setCurrentIndex(0)
        if current_txt and not current_txt.startswith("—"):
            self._set_combo_to_host(current_txt)
        self.host_combo.blockSignals(False)

        # Karten-Liste im Auswahlbildschirm aktualisieren
        while self.cards_layout.count():
            item = self.cards_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        if not self.stations:
            empty_lbl = QLabel(
                f"Keine Konfigurationsdateien in {STATIONS_CONFIG_DIR} gefunden.\n"
                f"Erstelle dort z. B. ws1.json bis ws5.json.",
                self.cards_container
            )
            empty_lbl.setStyleSheet("color: #f87171; font-size: 14px; padding: 20px;")
            self.cards_layout.addWidget(empty_lbl)
        else:
            for st in self.stations:
                card = StationCard(st, on_select=self.connect_to_station, parent=self.cards_container)
                self.cards_layout.addWidget(card)

        self.cards_layout.addStretch(1)
        if not (self.stream_thread and self.stream_thread.isRunning()):
            self.status_label.setText(
                f"{len(self.stations)} Maschinen-Konfiguration(en) aus {STATIONS_CONFIG_DIR} geladen. Bitte Maschine auswählen."
            )

    def _set_combo_to_host(self, host_or_id: str):
        key = host_or_id.strip().lower()
        for i in range(self.host_combo.count()):
            data = str(self.host_combo.itemData(i) or "").lower()
            if data and data == key:
                self.host_combo.setCurrentIndex(i)
                return
        st = self.station_map.get(key)
        if st:
            for i in range(self.host_combo.count()):
                if str(self.host_combo.itemData(i) or "").lower() == st["id"].lower():
                    self.host_combo.setCurrentIndex(i)
                    return
        self.host_combo.setCurrentText(host_or_id)

    def _select_and_connect_host(self, host_or_id: str):
        key = host_or_id.strip().lower()
        st = self.station_map.get(key)
        if st:
            self.connect_to_station(st)
        else:
            self._set_combo_to_host(host_or_id)
            QTimer.singleShot(100, self.toggle_connection)

    def _show_station_selector(self):
        if self.stream_thread and self.stream_thread.isRunning():
            self.stream_thread.stop()
        self.stack.setCurrentWidget(self.selector_page)

    def connect_to_station(self, station: dict):
        if self.stream_thread and self.stream_thread.isRunning():
            self.stream_thread.stop()
            self.stream_thread.wait(800)

        self._set_combo_to_host(station["id"])

        # Standard-FPS und Skalierung aus der Stations-Config übernehmen
        fps_val = station.get("default_fps", 30)
        for i in range(self.fps_combo.count()):
            if self.fps_combo.itemData(i) == fps_val:
                self.fps_combo.blockSignals(True)
                self.fps_combo.setCurrentIndex(i)
                self.fps_combo.blockSignals(False)
                break

        scale_val = station.get("default_scale", 100)
        for i in range(self.scale_combo.count()):
            if self.scale_combo.itemData(i) == scale_val:
                self.scale_combo.blockSignals(True)
                self.scale_combo.setCurrentIndex(i)
                self.scale_combo.blockSignals(False)
                break

        self._start_connection(
            target=station.get("ip") or station["host"],
            display_name=station["name"],
            sudo_pass=station.get("sudo_pass") or self.default_sudo_pass,
            user=station.get("user") or "",
            ssh_key=station.get("ssh_key") or ""
        )

    def _resolve_selected_station_or_host(self):
        idx = self.host_combo.currentIndex()
        data_id = str(self.host_combo.itemData(idx) or "").strip().lower()
        txt = self.host_combo.currentText().strip()
        if txt.startswith("—"):
            return None, ""

        # Prüfen, ob der Text dem Item-Text des gewählten Eintrags entspricht
        if idx > 0 and data_id in self.station_map and txt == self.host_combo.itemText(idx):
            st = self.station_map[data_id]
            return st, st["host"]

        # Freitext-Eingabe prüfen
        clean = txt.split("(", 1)[0].strip()
        if "–" in clean:
            clean = clean.split("–", 1)[0].strip()
        st = self.station_map.get(clean.lower())
        if st:
            return st, st["host"]
        return None, clean

    def toggle_connection(self):
        if self.stream_thread and self.stream_thread.isRunning():
            self.stream_thread.stop()
            return

        st, target = self._resolve_selected_station_or_host()
        if st:
            self.connect_to_station(st)
            return

        if not target:
            self.stack.setCurrentWidget(self.selector_page)
            QMessageBox.information(
                self,
                "Maschine auswählen",
                "Bitte wähle zuerst eine Maschine (WS1–WS5) aus der Übersicht oder im Dropdown aus."
            )
            return

        self._start_connection(
            target=target,
            display_name=target,
            sudo_pass=self.default_sudo_pass
        )

    def _start_connection(self, target: str, display_name: str, sudo_pass: str, user: str = "", ssh_key: str = ""):
        self.active_display_name = display_name
        self.connect_btn.setText("Trennen")
        self.connect_btn.setStyleSheet("background-color: #dc2626; border-color: #b91c1c;")
        self.host_combo.setEnabled(False)

        self.stack.setCurrentWidget(self.canvas)
        self.canvas.start_loading(f"Verbinde mit {display_name} ...")

        self.stream_thread = SSHStreamThread(
            target,
            sudo_pass=sudo_pass,
            user=user,
            ssh_key=ssh_key
        )
        self.stream_thread.frame_received.connect(self._on_frame)
        self.stream_thread.init_received.connect(self._on_init)
        self.stream_thread.status_received.connect(self._on_status)
        self.stream_thread.error_received.connect(self._on_error)
        self.stream_thread.disconnected.connect(self._on_disconnected)
        self.stream_thread.start()
        self.canvas.setFocus()

    def _on_init(self, info: dict):
        self.monitors = info.get("monitors", [])
        tw = info.get("total_width", 0)
        th = info.get("total_height", 0)

        self.mon_combo.blockSignals(True)
        self.mon_combo.clear()

        while self.mon_btn_layout.count():
            item = self.mon_btn_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self.mon_buttons = {}
        for m in self.monitors:
            idx = m["index"]
            self.mon_combo.addItem(m["label"], idx)
            btn = QPushButton(f"M{idx} ({m['name']})", self)
            btn.setCheckable(True)
            btn.setChecked(idx == 1)
            btn.clicked.connect(lambda checked, i=idx: self.select_monitor(i))
            self.mon_btn_layout.addWidget(btn)
            self.mon_buttons[idx] = btn

        self.mon_combo.blockSignals(False)
        self.current_mon_index = 1
        self._highlight_mon_button(1)
        if self.monitors:
            self.canvas.start_loading(f"Lade {self.monitors[0]['label']} ...")
        # Gewünschte FPS & Skalierung der gewählten Station anwenden
        self._send_stream_config()
        disp = getattr(self, "active_display_name", "Remote-Host")
        self.status_label.setText(
            f"Verbunden mit {disp} | {len(self.monitors)} Monitor(e) erkannt (Gesamtfläche: {tw}x{th})"
        )

    def _highlight_mon_button(self, active_idx: int):
        if not hasattr(self, "mon_buttons"):
            return
        for idx, btn in self.mon_buttons.items():
            btn.blockSignals(True)
            btn.setChecked(idx == active_idx)
            if idx == active_idx:
                btn.setStyleSheet("background-color: #f59e0b; color: #0f172a; border-color: #d97706;")
            else:
                btn.setStyleSheet("")
            btn.blockSignals(False)

    def select_monitor(self, mon_index: int):
        if mon_index == self.current_mon_index and not self.canvas.loading_active:
            self.canvas.setFocus()
            return
        self.current_mon_index = mon_index
        self._highlight_mon_button(mon_index)
        self.mon_combo.blockSignals(True)
        for i in range(self.mon_combo.count()):
            if self.mon_combo.itemData(i) == mon_index:
                self.mon_combo.setCurrentIndex(i)
                break
        self.mon_combo.blockSignals(False)

        mon_name = f"Monitor {mon_index}"
        for m in self.monitors:
            if m["index"] == mon_index:
                mon_name = f"Monitor {mon_index} ({m['name']})"
                break
        self.canvas.start_loading(f"Wechsle auf {mon_name} ...")
        self._send_stream_config()
        self.canvas.setFocus()

    def _on_monitor_combo_changed(self, idx: int):
        mon_index = self.mon_combo.currentData()
        if mon_index:
            self.select_monitor(int(mon_index))

    def _send_stream_config(self):
        if not self.stream_thread or not self.stream_thread.isRunning():
            return
        fps = int(self.fps_combo.currentData() or 30)
        scale = int(self.scale_combo.currentData() or 100)
        self.stream_thread.send_cmd({
            "t": "cfg",
            "mon": self.current_mon_index,
            "fps": fps,
            "scale": scale,
            "quality": 80
        })

    def _on_wake_clicked(self):
        if self.stream_thread and self.stream_thread.isRunning():
            self.canvas.start_loading("Wecke Bildschirme auf & aktualisiere Stream ...")
            self.stream_thread.send_cmd({"t": "wake"})
            self.status_label.setText("Aufweck- & Refresh-Signal an Ziel-PC gesendet...")
        self.canvas.setFocus()

    def _on_frame(self, mon_idx: int, img: QImage, byte_len: int):
        # Beim Monitorwechsel verwerfen wir evtl. noch unterwegs gewesene Frames des alten Monitors,
        # damit die Ladeanimation exakt beim ersten Frame des neuen Monitors endet!
        if mon_idx != self.current_mon_index:
            return
        self.frame_count += 1
        self.byte_count += byte_len
        self.canvas.update_frame(img)

    def _on_status(self, txt: str):
        self.status_label.setText(txt)

    def _on_error(self, err: str):
        self.canvas.stop_loading()
        self.status_label.setText(f"Fehler: {err}")

    def _on_disconnected(self):
        self.connect_btn.setText("Verbinden")
        self.connect_btn.setStyleSheet("background-color: #2563eb; border-color: #1d4ed8;")
        self.host_combo.setEnabled(True)
        self.canvas.clear_frame()
        self.stats_label.setText("")
        self.stack.setCurrentWidget(self.selector_page)
        self.status_label.setText("Verbindung getrennt – Bitte Maschine auswählen.")

    def _update_stats(self):
        if self.stream_thread and self.stream_thread.isRunning():
            fps = self.frame_count
            kbps = (self.byte_count * 8) / 1000.0
            self.frame_count = 0
            self.byte_count = 0
            self.stats_label.setText(f"Monitor {self.current_mon_index}  |  {fps} FPS  |  {kbps:.0f} kbit/s")
        else:
            self.frame_count = 0
            self.byte_count = 0

    def is_control_enabled(self) -> bool:
        return bool(self.ctrl_checkbox.isChecked() and self.stream_thread and self.stream_thread.isRunning())

    def send_mouse_move(self, rx: float, ry: float):
        if self.stream_thread:
            self.stream_thread.send_cmd({"t": "m", "x": round(rx, 4), "y": round(ry, 4)})

    def send_mouse_button(self, btn: int, pressed: bool, rx: float, ry: float):
        if self.stream_thread:
            self.stream_thread.send_cmd({"t": "b", "b": btn, "p": 1 if pressed else 0, "x": round(rx, 4), "y": round(ry, 4)})

    def send_mouse_wheel(self, dy: int, dx: int):
        if self.stream_thread:
            self.stream_thread.send_cmd({"t": "w", "dy": dy, "dx": dx})

    def send_key(self, evdev_code: int, pressed: bool):
        if self.stream_thread:
            self.stream_thread.send_cmd({"t": "k", "c": evdev_code, "p": 1 if pressed else 0})

    def toggle_fullscreen(self):
        if self.isFullScreen():
            self.showNormal()
            self.fs_btn.setText("⛶ Vollbild")
        else:
            self.showFullScreen()
            self.fs_btn.setText("⛶ Fenster")
        self.canvas.setFocus()

    def closeEvent(self, event):
        if self.stream_thread and self.stream_thread.isRunning():
            self.stream_thread.stop()
            self.stream_thread.wait(1500)
        super().closeEvent(event)


def main():
    parser = argparse.ArgumentParser(
        description="LanView – Unbeaufsichtigtes Linux/Wayland Remote-Desktop-Tool über SSH (DRM/KMS + uinput)"
    )
    parser.add_argument(
        "host", nargs="?", default=None,
        help="Optionaler Ziel-Host oder Stations-ID beim Start (ohne Angabe öffnet sich die Maschinen-Auswahl)"
    )
    parser.add_argument(
        "--sudo-pass", default="",
        help="Optionales Sudo-Passwort falls kein NOPASSWD aktiv ist"
    )
    args = parser.parse_args()

    app = QApplication(sys.argv)
    app.setApplicationName("LanView")
    app.setDesktopFileName("lanview")
    for icon_cand in (
        os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/lanview.svg"),
        os.path.expanduser("~/.local/share/icons/hicolor/256x256/apps/lanview.png"),
    ):
        if os.path.isfile(icon_cand):
            app.setWindowIcon(QIcon(icon_cand))
            break
    win = LanViewWindow(initial_host=args.host, sudo_pass=args.sudo_pass)
    if not app.windowIcon().isNull():
        win.setWindowIcon(app.windowIcon())
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
